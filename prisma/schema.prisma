generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  username            String   @unique
  password            String
  isGuest             Boolean  @default(false)
  /// 是否被管理员停用（停用后无法登录）
  disabled            Boolean  @default(false)
  /// 密保问题（预设问题的 key,如 "first_pet"）
  securityQuestion    String?
  /// 密保答案的 bcrypt 哈希
  securityAnswerHash  String?
  /// 职业（用于数据大屏职业统计）
  occupation          String?
  lastActiveAt        DateTime?
  createdAt           DateTime @default(now())
  admin               Admin?
  quizzes             Quiz[]
  results             QuizResult[]
  professionId        String?
  profession          Profession? @relation(fields: [professionId], references: [id])
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Quiz {
  id         String   @id @default(cuid())
  title      String
  questions  String   @db.Text
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOfficial Boolean  @default(false)
  /// 答题时长（分钟），0 = 不限时
  timeLimit  Int      @default(0)
  /// 题库分类 id。格式 "preset:<key>"(系统预设) 或 "user:<id>"(用户私有) 或 null(未分类)
  /// 用 string + 前缀方案避免两张分类表的 id 空间冲突
  categoryId String?  @db.VarChar(64)
  results     QuizResult[]
  assignments QuizAssignment[]
  createdAt   DateTime @default(now())

  /// 文件内容 SHA-256 指纹(hex)。null = 旧数据(无指纹,不参与去重)
  fileKey           String?
  /// 用户首次保存时设定的记录名(后续可改,作为暂存/提交默认值)
  defaultName       String?
  /// 默认归档分类 id(对应 CategoryContext localStorage 里的 Category.id)
  defaultCategoryId String?

  @@index([categoryId])
  @@unique([userId, fileKey])
  @@index([userId, fileKey])
}

model QuizResult {
  id          String   @id @default(cuid())
  name        String
  score       Int      @default(0)
  totalScore  Int      @default(0)
  results     String   @db.Text
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String   @default("submitted")
  submittedAt DateTime @default(now())
}

model Profession {
  id          String           @id @default(cuid())
  name        String           @unique
  createdAt   DateTime         @default(now())
  users       User[]
  assignments QuizAssignment[]
}

model QuizAssignment {
  id           String     @id @default(cuid())
  quizId       String
  quiz         Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  professionId String
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
  userId       String?
  createdAt    DateTime   @default(now())

  @@unique([quizId, professionId, userId])
  @@index([professionId])
  @@index([userId])
}

/// 管理员配置的 AI 厂商(用于题目解析)
model AIProviderConfig {
  id              String   @id @default(cuid())
  /// 友好名,如 "DeepSeek 主用"
  name            String
  /// 厂商 key: "deepseek" | "doubao" | "qwen" | "zhipu" | "custom"
  provider        String
  /// OpenAI 兼容 baseURL
  baseURL         String
  /// AES-256-GCM 加密后的 API key (iv + tag + ciphertext, base64)
  apiKeyCipher    String   @db.Text
  /// API key 末 4 位(用于 UI 展示,不暴露明文)
  apiKeyLast4     String
  /// 主对话模型
  model           String
  /// 视觉模型(可选)
  visionModel     String?
  /// 是否启用图片识别
  supportsVision  Boolean  @default(false)
  /// 当前激活厂商(全局唯一,通过事务切换)
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}
